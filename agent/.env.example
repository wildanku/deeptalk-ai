# Local development. Copy to `.env`; never commit real values.
# Variables marked (prod) are optional locally but required when APP_ENV=production.

APP_ENV=development
# local = deterministic echo model, no Vertex AI (development/tests only)
MODEL_PROVIDER=local
LOG_LEVEL=DEBUG

# Vertex AI — local runs use Application Default Credentials (`gcloud auth application-default login`)
GOOGLE_CLOUD_PROJECT=        # (prod)
# Gemini models are processed in the US (decision Q7); stored data stays in asia-southeast2
GOOGLE_CLOUD_LOCATION=us
GOOGLE_GENAI_USE_VERTEXAI=true
# Local only, instead of ADC: service account key file (keep it outside git, e.g. ../.creds/).
# Rejected in production — Cloud Run uses the attached service account.
GOOGLE_APPLICATION_CREDENTIALS=

# Model names (02 §7): gemini-4-argon for both tiers
MODEL_CHAT=                  # (prod) e.g. gemini-4-argon
MODEL_DOCUMENT=              # (prod) e.g. gemini-4-argon
# Thinking per tier: LOW | MEDIUM | HIGH (thinking tokens count toward MAX_OUTPUT_TOKENS)
THINKING_CHAT=LOW
THINKING_DOCUMENT=MEDIUM
# off = implicit caching only (Gemini 4 Argon); explicit = ADK context cache
CONTEXT_CACHE=off

SAFETY_TIMEOUT_MS=3000
# Local model only: simulate slow L2 (safety-gate timeout drills)
LOCAL_SAFETY_DELAY_MS=0
MAX_OUTPUT_TOKENS=2048

# Per-call bound on every model request (also sent as X-Server-Timeout) and attempts per call
# (408/429/5xx/transport errors retried with backoff)
MODEL_HTTP_TIMEOUT_MS=30000
MODEL_RETRY_ATTEMPTS=2
# Turn budget: no persona token by then → one invisible retry; whole persona; card decision
PERSONA_FIRST_TOKEN_TIMEOUT_MS=15000
PERSONA_TIMEOUT_MS=45000
CARDS_TIMEOUT_MS=8000
# One tiny model call at startup (auth/TLS/imports before the first user turn)
MODEL_WARMUP=true
