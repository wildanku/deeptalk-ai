# Local development. Copy to `.env`; never commit real values.
# Variables marked (prod) are optional locally but required when NODE_ENV=production.

NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
DEFAULT_TIMEZONE=Asia/Jakarta

# docker-compose.yml at the repo root (Postgres on 5433, Redis on 6380).
# Deployed: the AI Postgres and Redis services on the Dokploy VM, over the VPC private IP
# (e.g. redis://:<password>@10.x.x.x:6379) — docs/deeptalk-ai/topologi-deployment-151026.md
DATABASE_URL=postgresql://deeptalk_ai:deeptalk_ai@localhost:5433/deeptalk_ai
REDIS_URL=redis://localhost:6380
REDIS_PREFIX=deeptalk-ai

# Background work (02 §6.3): local = Postgres stand-in (dev/E2E); cloud = Google Cloud Tasks (prod)
TASKS_DRIVER=local
TASKS_LOCATION=asia-southeast2
TASKS_TARGET_URL=            # (prod) the gateway's own https URL; local default http://127.0.0.1:$PORT
TASKS_TOKEN=                 # (prod) openssl rand -hex 24; also required locally for tasks to run

# AI access token issued by deeptalk-api-v3 (02 §5.2)
AI_JWKS_URL=                 # (prod) e.g. http://localhost:3000/v2/.well-known/ai-jwks.json
AI_JWT_ISSUER=deeptalk-api
AI_JWT_AUDIENCE=deeptalk-ai

# deeptalk-api-v3 integration
DEEPTALK_API_URL=            # (prod) e.g. http://localhost:3000
PSIKOLOG_DIRECTORY_API_URL=  # optional; psikolog directory host, default DEEPTALK_API_URL
                             # (local v3 with an empty DB: https://api-deeptalk.lgs.web.id)
AI_SERVICE_TOKEN=            # (prod) >= 32 chars, same value as in v3
INBOUND_WEBHOOK_TOKEN=       # (prod) >= 32 chars, v3 → gateway webhook

# Private agent service
AGENT_URL=                   # (prod) e.g. http://localhost:8000
AGENT_AUTH=none              # production: id_token (Cloud Run IAM)
AGENT_TIMEOUT_MS=60000         # non-streaming calls (summary, handoff/persona draft, L2-only)
AGENT_TURN_TIMEOUT_MS=75000    # turn stream up to `done` (above the agent's PERSONA_TIMEOUT_MS)
AGENT_IDLE_TIMEOUT_MS=30000    # silence on the turn stream (agent pings every 15 s)
AGENT_CARDS_GRACE_MS=10000     # card events after `done`
ROUTER_TIMEOUT_MS=8000         # Quick Chat router; fallback persona past this
TURN_HISTORY_MESSAGES=20

# Message content encryption — exactly one of:
# Cloud KMS key: projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>
MESSAGE_KMS_KEY=             # (prod)
# Development only, rejected in production: openssl rand -base64 32
MESSAGE_LOCAL_KEY=

# Cloud Scheduler → /v1/internal/scheduler/* (x-scheduler-token), >= 32 chars
SCHEDULER_TOKEN=             # (prod)

# On-call webhook for crisis alerts (content-free); alerts are always logged at CRITICAL
ALERT_WEBHOOK_URL=
HELP_URL=https://deeptalk.co.id/deeptalk-ai/bantuan
RATE_LIMIT_MESSAGES_PER_MINUTE=20

# Use DRAFT clinical content when nothing is approved yet. Development only (rejected in prod).
CONTENT_ALLOW_DRAFT=true
CONTENT_CACHE_SECONDS=60

# Phase 6 — tracing to Cloud Trace (OTLP). Spans carry no content; see observability/tracing.ts
TRACING_EXPORTER=none        # otlp in dev/staging/prod
TRACING_OTLP_ENDPOINT=
TRACING_SAMPLE_RATIO=0.1
GOOGLE_CLOUD_PROJECT=

# Phase 4 — age gate (Q4), account lifecycle, retention (Q10: leave unset until decided)
AI_MIN_AGE=18
# Beta only: bypass service-consent gating for eligible users. Disable for official release.
AI_TRIAL_ALLOW_WITHOUT_SERVICE_CONSENT=false
ACCOUNT_SYNC_INTERVAL_SECONDS=300
RETENTION_MESSAGES_DAYS=
RETENTION_SUMMARIES_DAYS=
RETENTION_SAFETY_EVENTS_DAYS=
RETENTION_ROUTINE_LOGS_DAYS=
RETENTION_INSTRUMENT_RESPONSES_DAYS=
OUTBOX_RETENTION_DAYS=30

# Phase 5 — persona approval needs a fully rated evaluation over at least this many cases
PERSONA_MIN_EVAL_CASES=5

# Comma-separated web origins; empty = any origin (local only)
CORS_ORIGINS=                # (prod)

# Session, active time, quota (02 §6.3)
SESSION_QUOTA_PER_MONTH=10
SESSION_ACTIVE_LIMIT_SECONDS=1800
SESSION_WARNING_AT_SECONDS=1500
SESSION_GRACE_SECONDS=180
ACTIVE_GAP_CAP_SECONDS=120
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_MAX_WALL_CLOCK_SECONDS=10800

# Phase 9 — training-data tooling (off by default; also needs approval gates in ai_data_gates)
DATASET_ENABLED=false
# dlp (Sensitive Data Protection, required in production) | local (development only)
DATASET_DEID=local
DLP_LOCATION=asia-southeast2
DATASET_MIN_FINE_TUNING_ITEMS=1000
